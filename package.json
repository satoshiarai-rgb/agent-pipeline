{
  "name": "agent-pipeline",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "private": true,
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile=dist/cli.js",
    "check:dist": "bun run build && git diff --exit-code -- dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write",
    "lint": "biome check"
  },
  "type": "module"
}
